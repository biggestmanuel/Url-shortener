{
  "name": "linkly-backend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./server.js --watch-path=./lib --watch-path=./scripts server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "loadtest": "k6 run loadtest/linkly.js",
    "db:migrate": "node scripts/migrate.js",
    "doctor": "node scripts/doctor.js",
    "doctor:strict": "node scripts/doctor.js --strict",
    "db:inventory": "node scripts/inventory.js",
    "db:classify": "node scripts/classify.js",
    "db:links": "node scripts/links-admin.js",
    "db:prune-tests": "node scripts/prune-test-accounts.js",
    "db:sessions": "node scripts/session-stats.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0"
  }
}
