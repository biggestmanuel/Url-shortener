# --- Database ---------------------------------------------------------
# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Server -----------------------------------------------------------
PORT=3001
# Absolute origin that short links are built from. Set this when the
# backend is reachable on a real domain.
PUBLIC_BASE_URL=http://localhost:3001

# Where the frontend is served, used to build emailed links. Defaults to
# PUBLIC_BASE_URL, which is correct when both are on the same origin.
# Set this when the frontend and API are on different hosts.
#FRONTEND_BASE_URL=https://your-frontend.example.com

# `production` makes the checks below fatal rather than advisory: the server
# refuses to start with a loopback PUBLIC_BASE_URL, because that silently
# produces links nobody can open. Leave unset for local development.
#NODE_ENV=production
# Waive the loopback check for a genuine private-network deployment.
#ALLOW_LOOPBACK_BASE_URL=false

# --- Security ---------------------------------------------------------
# Master key. Send as the `x-api-key` header.
#   * Grants deletion of any link, including legacy rows that have no
#     owner token.
#   * Set REQUIRE_API_KEY_TO_CREATE=true to also gate link creation.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=
REQUIRE_API_KEY_TO_CREATE=false

# Set to true when running behind a reverse proxy/load balancer so that
# rate limiting sees real client IPs instead of the proxy's. Only
# 1/true/yes/on count as true, so this default genuinely stays off.
TRUST_PROXY=false

# --- Favicon proxy -----------------------------------------------------
# Icons are fetched by the backend and cached for a day.
FAVICON_RATE_MAX=120

# Comma-separated list of origins allowed to call the API. Leave empty to
# reflect any origin, which the local demo mode and a file:// frontend need.
# Set it when deploying, e.g.:
#   CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=

# --- Rate limiting (per client IP) ------------------------------------
CREATE_RATE_MAX=30
CREATE_RATE_WINDOW_MS=600000
REDIRECT_RATE_MAX=1200
REDIRECT_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000

# --- Email (password reset & address verification) ---------------------
# Without SMTP_HOST, messages are printed to the server log instead of being
# sent. That keeps resets reachable on a self-hosted instance; the token is
# never returned by the API either way.
# Install the optional transport with: npm --prefix backend install nodemailer
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Linkly <no-reply@your-domain.example>

# Token lifetimes, in minutes.
RESET_TOKEN_TTL_MINUTES=60
VERIFY_TOKEN_TTL_MINUTES=1440

# --- Sessions ----------------------------------------------------------
SESSION_TTL_DAYS=30
# How often to delete expired sessions. Expired rows are already inert, so
# this only bounds table growth. Set to 0 to disable.
SESSION_SWEEP_MINUTES=60